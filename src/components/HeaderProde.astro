---
/* Header del prode (css styles.css, estilo anterior al kit Vandú) hasta unificar estilos.
   Mismos links que el header del sitio (src/data/nav.js) y "Inicio" con la casita. */
import { LINKS, hrefDe, esActual } from '../data/nav.js';
import HomeIcon from './HomeIcon.astro';

const path = Astro.url.pathname;
---

<header class="brand-header">
  <a class="brand-header__logo" href="/" aria-label="22 · Volver a la página principal">
    <logo-loader-inverse color="currentColor" aria-hidden="true"></logo-loader-inverse>
  </a>
  <div class="brand-header__actions">
    <!-- Cuenta (src/scripts/cuenta.js): sin sesión abre el login; con sesión, el menú del usuario -->
    <div class="brand-header__user-wrap" data-user>
      <button
        class="brand-header__user"
        type="button"
        aria-label="Iniciar sesión"
        aria-expanded="false"
        aria-controls="user-menu"
        data-user-toggle
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
        </svg>
      </button>
      <div class="user-menu" id="user-menu" data-user-menu hidden>
        <p class="user-menu__name"><span data-user-fullname></span> <span class="user-menu__number" data-user-number></span></p>
        <p class="user-menu__email" data-user-email></p>
        <button class="user-menu__item" type="button" data-logout>Cerrar sesión</button>
      </div>
    </div>
    <!-- El link de venta sale de src/data/content.json (src/scripts/prode.js) -->
    <a class="btn brand-header__cta" href="/" data-cta="header">En breve</a>
    <!-- Menú de secciones (src/scripts/nav.js) -->
    <div class="brand-header__menu-wrap" data-nav>
      <button
        class="brand-header__burger"
        type="button"
        aria-label="Menú"
        aria-expanded="false"
        aria-controls="site-menu"
        data-nav-toggle
      >
        <span class="brand-header__burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
      <nav class="site-menu" id="site-menu" aria-label="Secciones" data-nav-menu hidden>
        <a class="site-menu__link site-menu__link--inicio" href="/">
          <span>Inicio</span>
          <HomeIcon />
        </a>
        {LINKS.map((link) => (
          <a class="site-menu__link" href={hrefDe(link, false)} aria-current={esActual(link, path) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  import '../scripts/nav.js';
</script>
