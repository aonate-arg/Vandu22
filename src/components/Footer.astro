---
/* Footer del sitio (kit Vandú, css site.css). Los links salen de src/data/nav.js. */
import { LINKS, LINKS_COMUNIDAD, hrefDe, esHome, esActual } from '../data/nav.js';
import { ZONA } from '../lib/fechas.js';

interface Props {
  /** Clase extra de la grilla (stickers usa "cols", de stickers.css) */
  gridClass?: string;
}
const { gridClass } = Astro.props;

const path = Astro.url.pathname;
const enHome = esHome(path);
const linksVandu = LINKS.filter((l) => !l.soloMenu);
// Año al publicar, en hora de Argentina (en la home, src/scripts/main.js lo actualiza al cargar)
const anio = new Intl.DateTimeFormat('es-AR', { year: 'numeric', timeZone: ZONA }).format(new Date());
---

<footer class="site-footer">
  <div class="vd-speed" aria-hidden="true"></div>
  <div class:list={['container site-footer__grid', gridClass]}>
    <div class="site-footer__brand">
      <a class="site-footer__logo" href={enHome ? '#inicio' : '/'} aria-label="Vandú, volver al inicio"><logo-loader-inverse color="currentColor" aria-hidden="true"></logo-loader-inverse></a>
      <p class="site-footer__tagline">La F1 se vive en comunidad.</p>
    </div>

    <nav class="site-footer__col" aria-labelledby="footer-vandu">
      <p class="vd-label" id="footer-vandu">Vandú</p>
      <ul role="list">
        {linksVandu.map((link) => (
          <li><a href={hrefDe(link, enHome)} aria-current={esActual(link, path) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-labelledby="footer-comunidad">
      <p class="vd-label" id="footer-comunidad">Comunidad</p>
      <ul role="list">
        {LINKS_COMUNIDAD.map((link) => (
          <li><a href={hrefDe(link, enHome)}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__col">
      <p class="vd-label">Seguinos</p>
      <div class="vd-social">
        <a href="https://www.instagram.com/vandu.f1/" target="_blank" rel="noopener" aria-label="Instagram de Vandú"
          ><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg
        ></a>
        <a href="https://www.tiktok.com/@thevandu" target="_blank" rel="noopener" aria-label="TikTok de Vandú"
          ><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.6 2.4 4.4 5 4.6" /></svg
        ></a>
      </div>
      <p class="site-footer__handle">@vandu.f1</p>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <a href="mailto:vngtdx@gmail.com">vngtdx@gmail.com</a>
    <span>Cucha Cucha 2595, CABA</span>
    <small>© <span data-year>{anio}</span> Vandu 22</small>
  </div>
</footer>
